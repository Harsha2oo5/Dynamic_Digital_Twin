# Python
__pycache__/
*.pyc
.pytest_cache/
backend/.venv/
backend/.env
backend/runtime/

# Models: keep the folder structure, not large weights (yolo11n.pt is re-downloadable)
backend/models/**/*.pt

# Generated datasets and experiment outputs
backend/dataset/*/
experiments/*/
# ...except the zero-shot experiment's code; its runs and downloaded weights stay local
!experiments/zero_shot_bts/
experiments/zero_shot_bts/runs/
experiments/zero_shot_bts/weights/

# Node
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Annotation exports (large, team-specific); the kit itself is tracked
annotation/exports/*/
# Staged image copies for annotation batches (batch_manifest.csv files stay tracked)
annotation/batches/*/*/
# Candidate/rejected run previews (regenerable)
annotation/candidates/*/previews/
annotation/rejected/*/previews/
annotation/candidates/*/contact_sheets/
annotation/rejected/*/contact_sheets/
# Pseudo-label runs: previews and the CLIP embedding cache are regenerable (labels, manifest, records, reports stay)
annotation/pseudo_labels/*/previews/
annotation/pseudo_labels/*/clip_cache.npz
experiments/zero_shot_bts/diagnostics/cache/
backend/models/anomaly/
