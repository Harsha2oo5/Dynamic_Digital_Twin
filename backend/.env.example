# Copy to .env and adjust. All values are optional; defaults shown.
# Execution device. Only "cpu" is supported in this milestone.
DEVICE=cpu

# Model selection: pretrained (COCO YOLO11n) or custom (fine-tuned Digital Twin components)
DETECTION_MODEL=pretrained
PRETRAINED_MODEL_PATH=models/pretrained/yolo11n.pt
CUSTOM_MODEL_PATH=models/custom/digital_twin_best.pt
# If DETECTION_MODEL=custom but the checkpoint is missing/broken:
#   false -> API starts in "degraded" mode with a clear error (no detection)
#   true  -> pretrained model is loaded instead and the dashboard shows a fallback warning
MODEL_FALLBACK_TO_PRETRAINED=false
# Optional explicit checkpoint override (takes precedence over DETECTION_MODEL)
# MODEL_PATH=models/custom/some_other.pt

CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Inference resolution (smaller = faster on CPU; 320/416/640)
IMAGE_SIZE=416
# Process every Nth video frame
FRAME_SKIP=1
# 0 = PyTorch default thread count
TORCH_THREADS=0
MAX_VIDEO_MB=200
MAX_VIDEO_FRAMES=5000
SAVE_ANNOTATED_VIDEO=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------------
# Telemetry (sensor integration). See docs/sensor-integration.md.
# APP_ENV=production disables the simulator entirely.
APP_ENV=development
TELEMETRY_ENABLED=true
# PostgreSQL (recommended). Without it a local SQLite file (runtime/telemetry.db) is used as a dev fallback.
# TELEMETRY_DATABASE_URL=postgresql+psycopg://dt_app:<password>@127.0.0.1:5432/dynamic_twin
# Required by POST /api/telemetry/ingest (header X-API-Key). Unset = HTTP ingestion is closed.
# TELEMETRY_INGEST_API_KEY=<long random string>
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_THRESHOLDS_FILE=configs/telemetry/thresholds.yaml
SITE_ID=SITE-001
SITE_NAME=BTS site

# Simulator (never starts by itself unless SIMULATOR_AUTOSTART=true; refused when APP_ENV=production)
SIMULATOR_CONFIG_FILE=configs/telemetry/simulator.yaml
SIMULATOR_AUTOSTART=false

# MQTT adapter (needs a broker, e.g. Mosquitto). Credentials only here, never in the database or API output.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC=bts/+/+/telemetry
