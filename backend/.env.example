# Copy to .env and adjust. All values are optional; defaults shown.
# Execution device. Only "cpu" is supported in this milestone.
DEVICE=cpu

# Model selection: pretrained (COCO YOLO11n) or custom (fine-tuned Digital Twin components)
DETECTION_MODEL=pretrained
PRETRAINED_MODEL_PATH=models/pretrained/yolo11n.pt
CUSTOM_MODEL_PATH=models/custom/digital_twin_best.pt
# If DETECTION_MODEL=custom but the checkpoint is missing/broken:
#   false -> API starts in "degraded" mode with a clear error (no detection)
#   true  -> pretrained model is loaded instead and the dashboard shows a fallback warning
MODEL_FALLBACK_TO_PRETRAINED=false
# Optional explicit checkpoint override (takes precedence over DETECTION_MODEL)
# MODEL_PATH=models/custom/some_other.pt

CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Inference resolution (smaller = faster on CPU; 320/416/640)
IMAGE_SIZE=416
# Process every Nth video frame
FRAME_SKIP=1
# 0 = PyTorch default thread count
TORCH_THREADS=0
MAX_VIDEO_MB=200
MAX_VIDEO_FRAMES=5000
SAVE_ANNOTATED_VIDEO=true
LOG_LEVEL=INFO
